{
  "name": "@particle-academy/fancy-sign-ui",
  "version": "0.4.0",
  "description": "React surfaces for simple electronic signatures (SES): the signer ceremony (email code, consent, document, fields, mark, sign or decline), envelope setup, timeline, completion certificate and verifier. Controlled, JSON-serializable, agent-bridgeable for management, and never agent-signable.",
  "keywords": [
    "e-signature",
    "esignature",
    "signature",
    "signing",
    "envelope",
    "react",
    "human-plus",
    "agent",
    "particle-academy"
  ],
  "homepage": "https://github.com/Particle-Academy/fancy-sign-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/fancy-sign-ui.git"
  },
  "bugs": "https://github.com/Particle-Academy/fancy-sign-ui/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./template": {
      "import": {
        "types": "./dist/template.d.ts",
        "default": "./dist/template.js"
      },
      "require": {
        "types": "./dist/template.d.cts",
        "default": "./dist/template.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "pretest": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint .",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsup"
  },
  "peerDependencies": {
    "@particle-academy/fancy-template-ui": ">=0.1.0 <2.0",
    "@particle-academy/react-fancy": ">=4.17.1 <7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@particle-academy/fancy-template-ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@particle-academy/fancy-doc-commons": "^0.4.0",
    "@particle-academy/fancy-template": "^0.5.0",
    "@particle-academy/fancy-template-ui": "^0.1.0",
    "@particle-academy/react-fancy": "^6.29.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "source-map-js": "^1.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
